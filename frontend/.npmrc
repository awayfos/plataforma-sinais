# npm 10 quebra ao resolver o conjunto de peers opcionais vitest → jsdom → @napi-rs/canvas
# ("Cannot read properties of null (reading edgesOut)"). Conferido de novo em 2026-11-26 ao gerar o
# package-lock.json no CI: sem esta opção a geração ainda falha. Todos os peers necessários estão
# declarados no package.json, e o lock foi gerado com esta mesma configuração (npm ci a respeita).
legacy-peer-deps=true
