# Copie para .env e ajuste (ou rode infra/dev.sh subir, que cria o .env). Nunca coloque segredos reais neste arquivo.
# Passo a passo do desenvolvimento local: docs/COMO-RODAR-LOCAL.md
SINAIS_AMBIENTE=dev
SINAIS_DATABASE_URL=postgresql://sinais:sinais@localhost:5432/sinais
SINAIS_REDIS_URL=redis://localhost:6379/0
SINAIS_NIVEL_LOG=INFO
SINAIS_BINANCE_WS_URL=wss://data-stream.binance.vision
SINAIS_BINANCE_REST_URL=https://api.binance.com
# Dias de histórico baixados na primeira execução (1 min e 1 s). No desenvolvimento use poucos dias
# (ex.: 3 e 1; o infra/dev.sh já faz isso): 730 dias levam horas para baixar.
SINAIS_HISTORICO_DIAS=730
SINAIS_HISTORICO_DIAS_1S=2

# API e contas. A chave abaixo é SÓ para desenvolvimento local: gere outra por ambiente com
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SINAIS_CHAVE_CIFRA=ZGVzZW52b2x2aW1lbnRvLW5hby11c2UtZW0tcHJvZCE=
# Cookies com Secure. Chrome/Edge/Firefox aceitam Secure em http://localhost. SÓ NO DESENVOLVIMENTO, se o navegador
# recusar (ex.: Safari), use SINAIS_COOKIE_SEGURO=false. Com SINAIS_AMBIENTE=prod, false é recusado.
SINAIS_COOKIE_SEGURO=true
SINAIS_SESSOES_SIMULTANEAS=1
# Origens aceitas no WebSocket, separadas por vírgula. Obrigatória em produção (só https://).
# Abra o site em http://localhost:3000 (não 127.0.0.1): é esta origem e é o host do cookie.
SINAIS_ORIGENS_PERMITIDAS=http://localhost:3000
# CIDRs dos proxies confiáveis (Next rewrite, nginx), ex.: 127.0.0.1/32,172.16.0.0/12
SINAIS_PROXIES_CONFIAVEIS=

# Usadas pelo Docker Compose
POSTGRES_DB=sinais
POSTGRES_USER=sinais
POSTGRES_PASSWORD=sinais
