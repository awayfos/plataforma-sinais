# Copie para .env e ajuste. Nunca coloque segredos reais neste arquivo.
SINAIS_AMBIENTE=dev
SINAIS_DATABASE_URL=postgresql://sinais:sinais@localhost:5432/sinais
SINAIS_REDIS_URL=redis://localhost:6379/0
SINAIS_NIVEL_LOG=INFO
SINAIS_BINANCE_WS_URL=wss://data-stream.binance.vision
SINAIS_BINANCE_REST_URL=https://api.binance.com
# Dias de histórico baixados na primeira execução (1 min e 1 s)
SINAIS_HISTORICO_DIAS=730
SINAIS_HISTORICO_DIAS_1S=2

# Usadas pelo Docker Compose
POSTGRES_DB=sinais
POSTGRES_USER=sinais
POSTGRES_PASSWORD=sinais
